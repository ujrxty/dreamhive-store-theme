{%- comment -%}
  Renders a product card.
  Params:
    product        - product object (required)
    image_ratio    - override settings.card_image_ratio (optional)
{%- endcomment -%}

{%- assign ratio = image_ratio | default: settings.card_image_ratio -%}
{%- assign second_image = product.media[1] -%}

<a href="{{ product.url }}" class="product-card" aria-label="{{ product.title | escape }}">
  <div class="product-card__media product-card__media--{{ ratio }}">
    {%- if product.featured_media -%}
      <img
        class="primary"
        src="{{ product.featured_media | image_url: width: 800 }}"
        srcset="{{ product.featured_media | image_url: width: 400 }} 400w, {{ product.featured_media | image_url: width: 800 }} 800w, {{ product.featured_media | image_url: width: 1200 }} 1200w"
        sizes="(min-width: 990px) 25vw, 50vw"
        alt="{{ product.featured_media.alt | escape | default: product.title }}"
        loading="lazy"
        width="800" height="1000">
      {%- if settings.card_show_second_image and second_image -%}
        <img
          class="secondary"
          src="{{ second_image | image_url: width: 800 }}"
          alt=""
          loading="lazy"
          width="800" height="1000">
      {%- endif -%}
    {%- else -%}
      <div style="width:100%;height:100%;background:var(--color-surface);"></div>
    {%- endif -%}

    {%- if settings.card_show_sale_badge and product.compare_at_price > product.price -%}
      <span class="product-card__badge">{{ 'products.product.on_sale' | t }}</span>
    {%- endif -%}

    {%- if settings.card_show_quick_add and product.available -%}
      <form method="post" action="/cart/add" class="product-card__quick-add-form" onclick="event.stopPropagation();">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="product-card__quick-add">Quick add</button>
      </form>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    {%- if settings.card_show_vendor and product.vendor != blank -%}
      <div class="product-card__vendor">{{ product.vendor }}</div>
    {%- endif -%}
    <h3 class="product-card__title">{{ product.title }}</h3>
    <div class="product-card__price">
      {%- render 'price', product: product -%}
    </div>
  </div>
</a>
