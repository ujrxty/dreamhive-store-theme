<aside class="cart-drawer" data-cart-drawer aria-hidden="true" aria-label="{{ 'general.cart.cart' | t }}">
  <div class="cart-drawer__header">
    <h2 class="h4" style="margin:0;">{{ 'general.cart.cart' | t }}</h2>
    <button type="button" data-cart-close aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
  </div>

  <div class="cart-drawer__items" data-cart-items></div>

  <div data-cart-empty hidden style="padding:40px 24px;text-align:center;color:var(--color-muted);">
    <p>{{ 'general.cart.empty' | t }}</p>
    <a href="/collections/all" class="btn btn--outline" style="margin-top:16px;">{{ 'general.cart.continue_shopping' | t }}</a>
  </div>

  <div class="cart-drawer__footer" data-cart-footer hidden>
    {%- if settings.cart_free_shipping_message != blank -%}
      <p style="font-size:0.8rem;color:var(--color-muted);text-align:center;margin-bottom:16px;">{{ settings.cart_free_shipping_message }}</p>
    {%- endif -%}
    <div style="display:flex;justify-content:space-between;margin-bottom:16px;">
      <span style="letter-spacing:0.12em;text-transform:uppercase;font-size:0.85rem;">{{ 'general.cart.subtotal' | t }}</span>
      <strong data-cart-subtotal></strong>
    </div>
    <a href="/checkout" class="btn" style="width:100%;">{{ 'general.cart.checkout' | t }}</a>
    <p style="font-size:0.75rem;color:var(--color-muted);text-align:center;margin-top:12px;">{{ 'general.cart.shipping_at_checkout' | t }}</p>
  </div>
</aside>
<div class="cart-drawer__backdrop" data-cart-backdrop></div>
