{%- assign og_title = page_title | default: shop.name -%}
{%- assign og_url = canonical_url | default: shop.url -%}
{%- assign og_type = 'website' -%}
{%- if request.page_type == 'product' -%}{%- assign og_type = 'product' -%}{%- endif -%}
{%- if request.page_type == 'article' -%}{%- assign og_type = 'article' -%}{%- endif -%}

{%- comment -%} Robust description: page > product > article > shop {%- endcomment -%}
{%- if request.page_type == 'product' and product -%}
  {%- assign og_description = product.description | strip_html | truncate: 155 -%}
{%- elsif request.page_type == 'collection' and collection -%}
  {%- assign og_description = collection.description | strip_html | default: collection.title | truncate: 155 -%}
{%- elsif request.page_type == 'article' and article -%}
  {%- assign og_description = article.excerpt_or_content | strip_html | truncate: 155 -%}
{%- elsif page_description -%}
  {%- assign og_description = page_description -%}
{%- else -%}
  {%- assign og_description = shop.description | default: shop.name -%}
{%- endif -%}

{%- if og_description != blank -%}
  <meta name="description" content="{{ og_description | escape }}">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
{%- if og_description != blank -%}
  <meta property="og:description" content="{{ og_description | escape }}">
{%- endif -%}
{%- if request.locale.iso_code -%}
  <meta property="og:locale" content="{{ request.locale.iso_code }}">
{%- endif -%}

{%- if request.page_type == 'product' and product.featured_media -%}
  <meta property="og:image" content="https:{{ product.featured_media | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: product.featured_media.aspect_ratio | round }}">
{%- elsif request.page_type == 'article' and article.image -%}
  <meta property="og:image" content="https:{{ article.image | image_url: width: 1200 }}">
{%- elsif settings.share_image -%}
  <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
{%- if og_description != blank -%}
  <meta name="twitter:description" content="{{ og_description | escape }}">
{%- endif -%}

{%- comment -%} ============ JSON-LD structured data ============ {%- endcomment -%}

{%- comment -%} Organization + WebSite (rendered on every page) {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }}{% if settings.logo %},
  "logo": "https:{{ settings.logo | image_url: width: 400 }}"{% endif %}{% if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_pinterest != blank or settings.social_tiktok != blank %},
  "sameAs": [
    {%- assign sep = '' -%}
    {%- if settings.social_instagram != blank %}{{ sep }}{{ settings.social_instagram | json }}{%- assign sep = ',' -%}{% endif %}
    {%- if settings.social_facebook != blank %}{{ sep }}{{ settings.social_facebook | json }}{%- assign sep = ',' -%}{% endif %}
    {%- if settings.social_pinterest != blank %}{{ sep }}{{ settings.social_pinterest | json }}{%- assign sep = ',' -%}{% endif %}
    {%- if settings.social_tiktok != blank %}{{ sep }}{{ settings.social_tiktok | json }}{%- assign sep = ',' -%}{% endif %}
    {%- if settings.social_youtube != blank %}{{ sep }}{{ settings.social_youtube | json }}{% endif %}
  ]{% endif %}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ shop.url }}/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- if request.page_type == 'product' and product -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  {%- if product.featured_media -%}
  "image": ["https:{{ product.featured_media | image_url: width: 1200 }}"],
  {%- endif -%}
  {%- if product.vendor != blank -%}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- else -%}
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  {%- endif -%}
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ shop.currency | json }},
    "price": {{ product.selected_or_first_available_variant.price | money_without_currency | remove: ',' | json }},
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "url": "{{ shop.url }}{{ product.url }}"
  }
}
</script>
{%- endif -%}

{%- if request.page_type == 'article' and article -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article.title | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author": { "@type": "Person", "name": {{ article.author | default: shop.name | json }} },
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }} }
  {%- if article.image %}, "image": "https:{{ article.image | image_url: width: 1200 }}"{% endif -%}
}
</script>
{%- endif -%}

{%- if request.page_type == 'collection' or request.page_type == 'product' or request.page_type == 'article' or request.page_type == 'page' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} }
    {%- if request.page_type == 'collection' and collection -%},
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": "{{ shop.url }}{{ collection.url }}" }
    {%- endif -%}
    {%- if request.page_type == 'product' and product -%}
    {%- if collection -%},
    { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": "{{ shop.url }}{{ collection.url }}" },
    { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": "{{ shop.url }}{{ product.url }}" }
    {%- else -%},
    { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": "{{ shop.url }}{{ product.url }}" }
    {%- endif -%}
    {%- endif -%}
    {%- if request.page_type == 'article' and article -%},
    { "@type": "ListItem", "position": 2, "name": {{ article.title | json }}, "item": "{{ shop.url }}{{ article.url }}" }
    {%- endif -%}
    {%- if request.page_type == 'page' and page -%},
    { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": "{{ shop.url }}{{ page.url }}" }
    {%- endif -%}
  ]
}
</script>
{%- endif -%}
