<section class="section {% if section.settings.background == 'surface' %}section--surface{% elsif section.settings.background == 'light' %}section--light{% endif %}">
  <div class="page-width">
    <div style="max-width:{{ section.settings.max_width }}px;margin:0 auto;text-align:{{ section.settings.text_align }};">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <div class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'heading' -%}
            <h2 {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            <div style="margin-top:24px;" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link }}" class="btn {% if block.settings.style == 'outline' %}btn--outline{% endif %}">{{ block.settings.text }}</a>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "range", "id": "max_width", "label": "Max content width (px)", "min": 400, "max": 1200, "step": 40, "default": 720 },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Surface" },
        { "value": "light", "label": "Light" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Our story" }] },
    { "type": "heading", "name": "Heading", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Beautiful things, built to last" }] },
    { "type": "text", "name": "Paragraph", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>DreamHive was born from a belief that quality furniture shouldn't be a luxury. We work directly with makers to bring you heirloom pieces at honest prices.</p>" }] },
    {
      "type": "button", "name": "Button",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "text" }]
    }
  ]
}
{% endschema %}
