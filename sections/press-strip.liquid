<section class="section {% if section.settings.background == 'surface' %}section--surface{% elsif section.settings.background == 'light' %}section--light{% endif %}" style="padding-top:48px;padding-bottom:48px;">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <p class="eyebrow text-center" style="display:block;margin-bottom:24px;">{{ section.settings.heading }}</p>
    {%- endif -%}
    <div class="press">
      {%- for block in section.blocks -%}
        {%- if block.settings.logo != blank -%}
          <img src="{{ block.settings.logo | image_url: width: 240 }}" alt="{{ block.settings.name | escape }}" loading="lazy" {{ block.shopify_attributes }}>
        {%- else -%}
          <span {{ block.shopify_attributes }}>{{ block.settings.name }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Press strip",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As featured in" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Surface" },
        { "value": "light", "label": "Light" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "press",
      "name": "Press mention",
      "settings": [
        { "type": "text", "id": "name", "label": "Publication name", "default": "Architectural Digest" },
        { "type": "image_picker", "id": "logo", "label": "Logo (optional, replaces text)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press strip",
      "blocks": [
        { "type": "press", "settings": { "name": "Architectural Digest" } },
        { "type": "press", "settings": { "name": "Dwell" } },
        { "type": "press", "settings": { "name": "Elle Decor" } },
        { "type": "press", "settings": { "name": "Apartment Therapy" } },
        { "type": "press", "settings": { "name": "House Beautiful" } }
      ]
    }
  ]
}
{% endschema %}
