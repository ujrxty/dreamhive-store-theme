<section class="section {% if section.settings.background == 'surface' %}section--surface{% elsif section.settings.background == 'light' %}section--light{% endif %}" data-carousel>
  <div class="page-width">
    <header style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:40px;flex-wrap:wrap;gap:24px;">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow--dot" data-reveal>{{ section.settings.eyebrow }}</div>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="display-xl" data-split="words" style="margin-top:16px;margin-bottom:0;">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      <div class="carousel-nav">
        <button type="button" data-carousel-prev aria-label="Previous">←</button>
        <button type="button" data-carousel-next aria-label="Next">→</button>
      </div>
    </header>

    {%- assign coll = collections[section.settings.collection] -%}
    <div class="carousel">
      {%- if coll.products.size > 0 -%}
        {%- for product in coll.products limit: section.settings.product_limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign demo_names = 'Halston Sofa,Marlow Bed Frame,Ellis Dining Table,Astor Armchair,Nolan Sideboard,Reed Coffee Table' | split: ',' -%}
        {%- assign demo_prices = '2495,1795,1495,895,1995,795' | split: ',' -%}
        {%- assign demo_imgs = 'look-1.jpg,cat-bedroom.jpg,cat-dining.jpg,look-3.jpg,editorial-craft.jpg,look-4.jpg' | split: ',' -%}
        {%- for i in (0..5) -%}
          <a href="#" class="product-card" aria-label="{{ demo_names[i] }}">
            <div class="product-card__media product-card__media--{{ settings.card_image_ratio }}">
              <img class="primary" src="{{ demo_imgs[i] | asset_url }}" alt="{{ demo_names[i] }}" loading="lazy" width="800" height="1000">
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title">{{ demo_names[i] }}</h3>
              <div class="product-card__price">${{ demo_prices[i] }}</div>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Just landed" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products", "min": 4, "max": 16, "step": 1, "default": 8 },
    {
      "type": "select", "id": "background", "label": "Background",
      "options": [{ "value": "default", "label": "Default" }, { "value": "surface", "label": "Surface" }, { "value": "light", "label": "Light" }],
      "default": "default"
    }
  ],
  "presets": [{ "name": "Product carousel" }]
}
{% endschema %}
