<section class="section" style="padding-top:0;padding-bottom:0;">
  <div class="editorial {% if section.settings.image_position == 'right' %}editorial--reverse{% endif %}">
    <div class="editorial__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1400 }}"
             srcset="{{ section.settings.image | image_url: width: 700 }} 700w, {{ section.settings.image | image_url: width: 1400 }} 1400w"
             sizes="50vw"
             alt="{{ section.settings.image.alt | escape }}"
             loading="lazy"
             width="1400" height="1050">
      {%- else -%}
        <img src="{{ 'editorial-craft.jpg' | asset_url }}" alt="" loading="lazy" width="1400" height="1050" style="width:100%;height:100%;object-fit:cover;min-height:520px;">
      {%- endif -%}
    </div>
    <div class="editorial__content">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<div>{{ section.settings.body }}</div>{%- endif -%}
      {%- if section.settings.button_text != blank -%}
        <div style="margin-top:16px;">
          <a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_text }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Craftsmanship" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to be lived in for a lifetime" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Solid hardwood frames, hand-finished by furniture-makers with decades of experience. Every DreamHive piece is quality-checked before it leaves our workshop.</p>" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Our story" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Editorial banner" }]
}
{% endschema %}
