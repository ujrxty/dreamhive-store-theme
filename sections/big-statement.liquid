<section class="statement {% if section.settings.background == 'surface' %}section--surface{% elsif section.settings.background == 'light' %}section--light{% endif %}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <div class="eyebrow--dot" data-reveal style="justify-content:center;margin-bottom:40px;">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h2 class="statement__text" data-split="words">{{ section.settings.text }}</h2>
    {%- if section.settings.button_text != blank -%}
      <div style="margin-top:48px;" data-reveal data-reveal-delay="3">
        <a href="{{ section.settings.button_link | default: '#' }}" class="btn" data-magnetic="0.25">{{ section.settings.button_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Big statement",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our philosophy" },
    {
      "type": "richtext", "id": "text", "label": "Statement",
      "default": "<p>We believe furniture should <em>outlive trends</em>. Every DreamHive piece is designed to be loved for a lifetime — and passed on.</p>"
    },
    { "type": "text", "id": "button_text", "label": "Button text" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "background", "label": "Background",
      "options": [{ "value": "default", "label": "Default" }, { "value": "surface", "label": "Surface" }, { "value": "light", "label": "Light" }],
      "default": "default"
    }
  ],
  "presets": [{ "name": "Big statement" }]
}
{% endschema %}
