<section class="section">
  <div class="page-width">
    <header style="margin-bottom:48px;max-width:640px;">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow--dot" data-reveal>{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="display-xl" data-split="words" style="margin-top:16px;">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p data-reveal data-reveal-delay="1" style="color:var(--color-muted);margin-top:16px;font-size:1.02rem;max-width:52ch;">{{ section.settings.subheading }}</p>{%- endif -%}
    </header>

    <div class="size-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="size-tile" data-reveal {{ block.shopify_attributes }}>
          <div class="size-tile__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.name | escape }} mattress" loading="lazy" width="900" height="1000">
            {%- elsif block.settings.fallback_asset != blank -%}
              <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.name | escape }} mattress" loading="lazy" width="900" height="1000">
            {%- endif -%}
          </div>
          <div class="size-tile__info">
            <div class="size-tile__dim">{{ block.settings.dimensions }}</div>
            <div class="size-tile__name">{{ block.settings.name }}</div>
            <div class="size-tile__price">{{ block.settings.price }}</div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .size-grid { display: grid; grid-template-columns: repeat({{ section.settings.columns }}, 1fr); gap: clamp(12px, 2vw, 24px); }
  @media (max-width: 989px) { .size-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 400px) { .size-grid { grid-template-columns: 1fr; } }
  .size-tile { display: block; text-decoration: none; color: inherit; transition: transform 400ms cubic-bezier(0.22,1,0.36,1); }
  .size-tile:hover { transform: translateY(-4px); }
  .size-tile__media { aspect-ratio: 4/5; overflow: hidden; border-radius: var(--radius); background: var(--color-surface); margin-bottom: 16px; position: relative; }
  .size-tile__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 700ms cubic-bezier(0.22,1,0.36,1); }
  .size-tile:hover .size-tile__media img { transform: scale(1.06); }
  .size-tile__dim { font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-gold); margin-bottom: 6px; }
  .size-tile__name { font-family: var(--font-heading); font-size: 1.4rem; margin-bottom: 4px; }
  .size-tile__price { color: var(--color-muted); font-size: 0.9rem; }
</style>

{% schema %}
{
  "name": "Size grid",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Every size" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fits your bed. And your budget." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "From dorm room to primary suite. All sizes ship free and arrive in a box." },
    { "type": "range", "id": "columns", "label": "Columns", "min": 3, "max": 5, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback asset", "default": "size-queen.jpg" },
        { "type": "text", "id": "name", "label": "Name", "default": "Queen" },
        { "type": "text", "id": "dimensions", "label": "Dimensions", "default": "60 x 80 in" },
        { "type": "text", "id": "price", "label": "Price label", "default": "From $1,295" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Size grid",
      "blocks": [
        { "type": "size", "settings": { "name": "Twin", "dimensions": "38 x 75 in", "price": "From $795", "fallback_asset": "size-twin.jpg" } },
        { "type": "size", "settings": { "name": "Queen", "dimensions": "60 x 80 in", "price": "From $1,295", "fallback_asset": "size-queen.jpg" } },
        { "type": "size", "settings": { "name": "King", "dimensions": "76 x 80 in", "price": "From $1,595", "fallback_asset": "size-king.jpg" } },
        { "type": "size", "settings": { "name": "Cal King", "dimensions": "72 x 84 in", "price": "From $1,595", "fallback_asset": "size-cal-king.jpg" } }
      ]
    }
  ]
}
{% endschema %}
