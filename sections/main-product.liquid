<section class="page-width pdp" data-gallery>
  <div class="pdp__gallery">
    <div class="pdp__gallery-main" data-gallery-main data-zoom>
      {%- if product.featured_media -%}
        <img src="{{ product.featured_media | image_url: width: 1400 }}"
             srcset="{{ product.featured_media | image_url: width: 700 }} 700w, {{ product.featured_media | image_url: width: 1400 }} 1400w"
             sizes="(min-width: 990px) 55vw, 100vw"
             alt="{{ product.featured_media.alt | escape | default: product.title }}"
             loading="eager" width="1400" height="1750" data-zoom-src="{{ product.featured_media | image_url: width: 2400 }}">
      {%- else -%}
        <img src="{{ 'look-1.jpg' | asset_url }}" alt="{{ product.title | escape }}" width="1400" height="1750" data-zoom-src="{{ 'look-1.jpg' | asset_url }}">
      {%- endif -%}
    </div>
    {%- if product.media.size > 1 -%}
      <div class="pdp__gallery-thumbs">
        {%- for media in product.media limit: 6 -%}
          <button type="button" data-gallery-thumb data-src="{{ media | image_url: width: 1400 }}" data-zoom="{{ media | image_url: width: 2400 }}"{% if forloop.first %} class="active"{% endif %} aria-label="View image {{ forloop.index }}">
            <img src="{{ media | image_url: width: 200 }}" alt="" loading="lazy" width="200" height="200">
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="pdp__info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'vendor' -%}
          {%- if product.vendor != blank -%}<div class="pdp__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</div>{%- endif -%}

        {%- when 'title' -%}
          <h1 class="pdp__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

        {%- when 'rating' -%}
          <div style="margin-bottom:16px;color:var(--color-gold);letter-spacing:3px;" {{ block.shopify_attributes }}>
            {%- for i in (1..5) -%}★{%- endfor -%}
            <span style="color:var(--color-muted);letter-spacing:normal;font-size:0.85rem;margin-left:8px;">{{ block.settings.review_count }}</span>
          </div>

        {%- when 'price' -%}
          <div class="pdp__price" data-pdp-price {{ block.shopify_attributes }}>
            {%- render 'price', product: product -%}
          </div>
          {%- if block.settings.show_installments -%}
            <div class="pdp__installments">{{ block.settings.installments_text }}</div>
          {%- endif -%}

        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}
            <div style="margin:16px 0;color:var(--color-muted);font-size:0.95rem;" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- endif -%}

        {%- when 'variant_picker' -%}
          <form method="post" action="{{ routes.cart_add_url }}" data-variant-form data-variants='{% for v in product.variants %}{"id":{{ v.id }},"options":{{ v.options | json }},"available":{{ v.available }},"price_html":"{{ v.price | money }}"}{% unless forloop.last %},{% endunless %}{% endfor %}' {{ block.shopify_attributes }}>
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            {%- for option in product.options_with_values -%}
              <div class="pdp__variant-group" data-option-index="{{ forloop.index0 }}">
                <span class="pdp__variant-label">{{ option.name }}: <strong data-selected-value style="color:var(--color-text);">{{ option.selected_value }}</strong></span>
                <div class="pdp__variant-options">
                  {%- for value in option.values -%}
                    <label>
                      <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value }}"{% if option.selected_value == value %} checked{% endif %}>
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}

            <div class="pdp__qty" data-qty-wrap>
              <span class="pdp__variant-label" style="margin-bottom:0;">{{ 'products.product.quantity' | t }}</span>
              <button type="button" data-qty-dec aria-label="Decrease">−</button>
              <input type="number" name="quantity" value="1" min="1">
              <button type="button" data-qty-inc aria-label="Increase">+</button>
            </div>

            <button type="submit" class="btn pdp__atc" data-pdp-atc data-magnetic="0.15" style="width:100%;" {% unless product.available %}disabled{% endunless %}>
              {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
            </button>

            {%- if block.settings.show_dynamic_checkout and product.selling_plan_groups == empty -%}
              <div style="margin-top:12px;">{{ form | payment_button }}</div>
            {%- endif -%}
          </form>

        {%- when 'description' -%}
          <div style="margin:24px 0;color:var(--color-muted);line-height:1.7;" {{ block.shopify_attributes }}>
            {{ product.description }}
          </div>

        {%- when 'trust' -%}
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:20px 0;border-top:1px solid var(--color-border);margin-top:16px;" {{ block.shopify_attributes }}>
            <div style="text-align:center;">
              <div style="color:var(--color-gold);margin-bottom:6px;">{% render 'icon', name: 'truck' %}</div>
              <div style="font-size:0.72rem;color:var(--color-muted);letter-spacing:0.06em;text-transform:uppercase;">{{ block.settings.trust_1 }}</div>
            </div>
            <div style="text-align:center;">
              <div style="color:var(--color-gold);margin-bottom:6px;">{% render 'icon', name: 'shield' %}</div>
              <div style="font-size:0.72rem;color:var(--color-muted);letter-spacing:0.06em;text-transform:uppercase;">{{ block.settings.trust_2 }}</div>
            </div>
            <div style="text-align:center;">
              <div style="color:var(--color-gold);margin-bottom:6px;">{% render 'icon', name: 'refresh' %}</div>
              <div style="font-size:0.72rem;color:var(--color-muted);letter-spacing:0.06em;text-transform:uppercase;">{{ block.settings.trust_3 }}</div>
            </div>
          </div>

        {%- when 'collapsible' -%}
          <div class="pdp__meta" {{ block.shopify_attributes }}>
            <details {% if block.settings.open_by_default %}open{% endif %}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="content">{{ block.settings.content }}</div>
            </details>
          </div>

        {%- when 'spec_table' -%}
          {%- if block.settings.rows != blank -%}
            <div style="margin-top:24px;" {{ block.shopify_attributes }}>
              <div style="font-size:0.78rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-gold);margin-bottom:12px;">{{ block.settings.heading }}</div>
              <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
                {%- assign lines = block.settings.rows | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}
                  {%- assign parts = line | split: ':' -%}
                  {%- if parts.size == 2 -%}
                    <tr>
                      <td style="padding:10px 0;color:var(--color-muted);border-bottom:1px solid var(--color-border);width:40%;">{{ parts[0] | strip }}</td>
                      <td style="padding:10px 0;border-bottom:1px solid var(--color-border);">{{ parts[1] | strip }}</td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </table>
            </div>
          {%- endif -%}

        {%- when 'share' -%}
          <div style="margin-top:24px;display:flex;gap:12px;color:var(--color-muted);font-size:0.85rem;align-items:center;" {{ block.shopify_attributes }}>
            <span>Share:</span>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ product.url }}" target="_blank" rel="noopener" aria-label="Share on Facebook">{% render 'icon', name: 'facebook' %}</a>
            <a href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ product.url }}&media={{ product.featured_image | image_url: width: 800 | prepend: 'https:' }}&description={{ product.title | url_encode }}" target="_blank" rel="noopener" aria-label="Pin on Pinterest">{% render 'icon', name: 'pinterest' %}</a>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{%- if section.settings.show_sticky_atc -%}
  <div class="pdp-sticky-atc" data-pdp-sticky hidden>
    <div class="page-width" style="display:flex;justify-content:space-between;align-items:center;gap:16px;padding:12px 0;">
      <div style="display:flex;align-items:center;gap:12px;min-width:0;">
        {%- if product.featured_media -%}
          <img src="{{ product.featured_media | image_url: width: 120 }}" alt="" width="48" height="60" style="width:48px;height:60px;object-fit:cover;border-radius:var(--radius);flex:0 0 auto;">
        {%- endif -%}
        <div style="min-width:0;">
          <div style="font-family:var(--font-heading);font-size:1rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{ product.title }}</div>
          <div style="font-size:0.85rem;color:var(--color-muted);">{{ product.selected_or_first_available_variant.price | money }}</div>
        </div>
      </div>
      <a href="#pdp-atc" class="btn" style="padding:12px 24px;min-height:auto;flex:0 0 auto;" onclick="document.querySelector('[data-pdp-atc]')?.click();return false;">{{ 'products.product.add_to_cart' | t }}</a>
    </div>
  </div>
  <style>
    .pdp-sticky-atc { position: fixed; bottom: 0; left: 0; right: 0; background: var(--color-bg); border-top: 1px solid var(--color-border); z-index: 40; transform: translateY(100%); transition: transform 300ms ease; }
    .pdp-sticky-atc.is-visible { transform: translateY(0); }
  </style>
  <script>
    (function() {
      const bar = document.querySelector('[data-pdp-sticky]');
      const atc = document.querySelector('[data-pdp-atc]');
      if (!bar || !atc) return;
      bar.hidden = false;
      const io = new IntersectionObserver(([entry]) => {
        bar.classList.toggle('is-visible', !entry.isIntersecting);
      }, { threshold: 0 });
      io.observe(atc);
    })();
  </script>
{%- endif -%}

<script>
  (function(){
    const zoomEl = document.querySelector('[data-zoom]');
    if (!zoomEl) return;
    const img = zoomEl.querySelector('img');
    if (!img) return;
    zoomEl.addEventListener('mousemove', (e) => {
      const rect = zoomEl.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      img.style.transformOrigin = x + '% ' + y + '%';
      img.style.transform = 'scale(1.6)';
    });
    zoomEl.addEventListener('mouseleave', () => { img.style.transform = ''; });
  })();
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_sticky_atc", "label": "Show sticky add-to-cart bar (mobile & scroll)", "default": true }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "rating", "name": "Rating", "limit": 1, "settings": [{ "type": "text", "id": "review_count", "label": "Review count text", "default": "(214 reviews)" }] },
    {
      "type": "price", "name": "Price", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_installments", "label": "Show installments hint", "default": true },
        { "type": "text", "id": "installments_text", "label": "Installments text", "default": "or 4 interest-free payments with Shop Pay" }
      ]
    },
    { "type": "text", "name": "Short text", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>A defining piece for the modern home.</p>" }] },
    { "type": "variant_picker", "name": "Variants + ATC", "limit": 1, "settings": [{ "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Shop Pay dynamic checkout", "default": true }] },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "trust", "name": "Trust icons", "limit": 1,
      "settings": [
        { "type": "text", "id": "trust_1", "label": "Trust 1", "default": "Free shipping" },
        { "type": "text", "id": "trust_2", "label": "Trust 2", "default": "10-yr warranty" },
        { "type": "text", "id": "trust_3", "label": "Trust 3", "default": "Easy returns" }
      ]
    },
    {
      "type": "collapsible", "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Dimensions & materials" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Solid oak frame, top-grain leather upholstery, hand-tied springs.</p>" },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "spec_table", "name": "Spec table",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" },
        { "type": "textarea", "id": "rows", "label": "Rows (Key: Value per line)", "default": "Width: 84 in\nDepth: 38 in\nHeight: 32 in\nSeat height: 18 in\nMaterial: Solid oak, top-grain leather\nCare: Wipe with dry cloth" }
      ]
    },
    { "type": "share", "name": "Share", "limit": 1 }
  ]
}
{% endschema %}
