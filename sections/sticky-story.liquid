<section class="section {% if section.settings.background == 'surface' %}section--surface{% elsif section.settings.background == 'light' %}section--light{% endif %}">
  <div class="page-width">
    <header class="sticky-story-header" style="margin-bottom:48px;max-width:640px;">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow--dot" data-reveal>{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="display-xl" data-split="words" style="margin-top:16px;">{{ section.settings.heading }}</h2>{%- endif -%}
    </header>

    <div class="sticky-scroll" data-sticky-scroll>
      <div class="sticky-scroll__media" data-sticky-media>
        {%- for block in section.blocks -%}
          {%- assign img = block.settings.image -%}
          {%- if img != blank -%}
            <img src="{{ img | image_url: width: 1200 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="1200" height="1500">
          {%- elsif block.settings.fallback_asset != blank -%}
            <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="1200" height="1500">
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="sticky-scroll__content">
        {%- for block in section.blocks -%}
          <div data-sticky-step="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="eyebrow--dot" style="margin-bottom:16px;">Chapter {{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.body }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sticky story",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it's made" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From workshop to your living room" },
    {
      "type": "select", "id": "background", "label": "Background",
      "options": [{ "value": "default", "label": "Default" }, { "value": "surface", "label": "Surface" }, { "value": "light", "label": "Light" }],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback asset", "default": "editorial-craft.jpg" },
        { "type": "text", "id": "title", "label": "Title", "default": "Kiln-dried in Vermont" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Every frame begins with Appalachian hardwood, kiln-dried for eight weeks to stabilize the grain before a saw ever touches it." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sticky story",
      "blocks": [
        { "type": "chapter", "settings": { "title": "Kiln-dried in Vermont", "body": "Every frame begins with Appalachian hardwood, kiln-dried for eight weeks to stabilize the grain before a saw ever touches it.", "fallback_asset": "editorial-craft.jpg" } },
        { "type": "chapter", "settings": { "title": "Joined by hand", "body": "Mortise-and-tenon joinery the same technique that's held furniture together for 500 years. No staples, no shortcuts.", "fallback_asset": "cat-bedroom.jpg" } },
        { "type": "chapter", "settings": { "title": "Finished with care", "body": "Hand-rubbed oils and waxes bring out the wood's natural depth. No plastic sheens, no VOC lacquers.", "fallback_asset": "cat-dining.jpg" } }
      ]
    }
  ]
}
{% endschema %}
