<section class="section {% if section.settings.background == 'surface' %}section--surface{% elsif section.settings.background == 'light' %}section--light{% endif %}">
  <div class="page-width">
    <div class="newsletter">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.email' | t }}" required aria-label="Email">
        <button type="submit" class="btn">{{ section.settings.button_text }}</button>
        {%- if form.posted_successfully? -%}
          <p style="color:var(--color-gold);margin-top:12px;">{{ 'general.newsletter.success' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay inspired" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the DreamHive list" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "10% off your first order and design stories delivered monthly." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Subscribe" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Surface" },
        { "value": "light", "label": "Light" }
      ],
      "default": "surface"
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
