<section class="section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header class="section-header">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="grid grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }} style="display:block;overflow:hidden;border-radius:var(--radius);aspect-ratio:1/1;background:var(--color-surface);">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 700 }}"
                 srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 700 }} 700w"
                 sizes="(min-width: 990px) 25vw, 50vw"
                 alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="700" height="700" style="width:100%;height:100%;object-fit:cover;transition:transform 500ms;">
          {%- elsif block.settings.fallback_asset != blank -%}
            <img src="{{ block.settings.fallback_asset | asset_url }}" alt="" loading="lazy" width="700" height="700" style="width:100%;height:100%;object-fit:cover;transition:transform 500ms;">
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "@dreamhive" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tag us in your space" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "columns", "label": "Columns", "min": 3, "max": 4, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback asset (dev only)", "default": "look-1.jpg" }
      ]
    }
  ],
  "presets": [
    { "name": "Lookbook", "blocks": [
      { "type": "photo", "settings": { "fallback_asset": "look-1.jpg" } },
      { "type": "photo", "settings": { "fallback_asset": "look-2.jpg" } },
      { "type": "photo", "settings": { "fallback_asset": "look-3.jpg" } },
      { "type": "photo", "settings": { "fallback_asset": "look-4.jpg" } }
    ] }
  ]
}
{% endschema %}
