<section class="section {% if section.settings.background == 'surface' %}section--surface{% elsif section.settings.background == 'light' %}section--light{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header style="text-align:center;max-width:640px;margin:0 auto 48px;">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow--dot" style="justify-content:center;" data-reveal>{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2 class="display-xl" data-split="words" style="margin-top:16px;">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}<p data-reveal data-reveal-delay="1" style="color:var(--color-muted);margin-top:16px;">{{ section.settings.subheading }}</p>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="lookbook-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="lookbook-tile lookbook-tile--{{ block.settings.size }}" data-reveal {{ block.shopify_attributes }}>
          <div class="lookbook-tile__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.caption | escape }}" loading="lazy" width="1200" height="1500">
            {%- elsif block.settings.fallback_asset != blank -%}
              <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.caption | escape }}" loading="lazy" width="1200" height="1500">
            {%- endif -%}
          </div>
          {%- if block.settings.caption != blank or block.settings.handle != blank -%}
            <div class="lookbook-tile__overlay">
              {%- if block.settings.handle != blank -%}<span class="lookbook-tile__handle">{{ block.settings.handle }}</span>{%- endif -%}
              {%- if block.settings.caption != blank -%}<span class="lookbook-tile__caption">{{ block.settings.caption }}</span>{%- endif -%}
            </div>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div style="text-align:center;margin-top:48px;" data-reveal>
        <a href="{{ section.settings.cta_link | default: '#' }}" class="btn btn--outline" data-magnetic="0.25">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .lookbook-grid { display: grid; grid-template-columns: repeat(6, 1fr); grid-auto-rows: 180px; gap: 12px; }
  @media (max-width: 989px) { .lookbook-grid { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 140px; } }
  @media (max-width: 549px) { .lookbook-grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 200px; } }
  .lookbook-tile { position: relative; overflow: hidden; border-radius: var(--radius); display: block; grid-column: span 2; grid-row: span 2; }
  .lookbook-tile--wide { grid-column: span 3; grid-row: span 2; }
  .lookbook-tile--tall { grid-column: span 2; grid-row: span 3; }
  .lookbook-tile--small { grid-column: span 1; grid-row: span 1; }
  @media (max-width: 549px) {
    .lookbook-tile, .lookbook-tile--wide, .lookbook-tile--tall, .lookbook-tile--small { grid-column: span 1; grid-row: span 1; }
  }
  .lookbook-tile__media { position: absolute; inset: 0; }
  .lookbook-tile__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms cubic-bezier(0.22,1,0.36,1); }
  .lookbook-tile:hover .lookbook-tile__media img { transform: scale(1.08); }
  .lookbook-tile__overlay { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 20px; background: linear-gradient(180deg, transparent 55%, rgba(0,0,0,0.75) 100%); color: #fff; opacity: 0; transition: opacity 320ms ease; }
  .lookbook-tile:hover .lookbook-tile__overlay { opacity: 1; }
  .lookbook-tile__handle { font-size: 0.72rem; letter-spacing: 0.14em; color: var(--color-gold); margin-bottom: 4px; }
  .lookbook-tile__caption { font-family: var(--font-heading); font-size: 1.1rem; line-height: 1.2; }
</style>

{% schema %}
{
  "name": "Lookbook",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "#DreamHiveSleep" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The mornings you deserve" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Real customers, real bedrooms. Share your sanctuary with #DreamHiveSleep." },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Follow @dreamhive on Instagram" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    {
      "type": "select", "id": "background", "label": "Background",
      "options": [{ "value": "default", "label": "Default" }, { "value": "surface", "label": "Surface" }, { "value": "light", "label": "Light" }],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback asset", "default": "mattress-1.jpg" },
        {
          "type": "select", "id": "size", "label": "Tile size",
          "options": [
            { "value": "default", "label": "Regular (2x2)" },
            { "value": "wide", "label": "Wide (3x2)" },
            { "value": "tall", "label": "Tall (2x3)" }
          ],
          "default": "default"
        },
        { "type": "text", "id": "handle", "label": "IG handle / label", "default": "@sarah.brooklyn" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "First morning in the Original. Never sleeping on anything else." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        { "type": "photo", "settings": { "size": "wide", "handle": "@sarah.brooklyn", "caption": "First morning in the Original.", "fallback_asset": "mattress-1.jpg" } },
        { "type": "photo", "settings": { "size": "default", "handle": "@james.austin", "caption": "8 hours, uninterrupted.", "fallback_asset": "mattress-2.jpg" } },
        { "type": "photo", "settings": { "size": "default", "handle": "@priya.sf", "caption": "Best decision this year.", "fallback_asset": "mattress-3.jpg" } },
        { "type": "photo", "settings": { "size": "wide", "handle": "@casa.miller", "caption": "Guest room upgrade complete.", "fallback_asset": "mattress-4.jpg" } }
      ]
    }
  ]
}
{% endschema %}
