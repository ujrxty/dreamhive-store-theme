<section class="page-width" style="padding:80px 0;">
  <header style="text-align:center;max-width:720px;margin:0 auto 60px;">
    {%- if section.settings.eyebrow != blank -%}
      <div class="eyebrow--dot" style="justify-content:center;">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h1 class="display-xl" style="margin-top:16px;">{{ page.title }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p style="color:var(--color-muted);margin-top:16px;font-size:1.05rem;">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </header>
  <div class="rte" style="max-width:720px;margin:0 auto;line-height:1.8;font-size:1.02rem;">
    {{ page.content }}
  </div>
</section>

<style>
  .rte h2 { font-family: var(--font-heading); font-size: 1.8rem; margin-top: 40px; margin-bottom: 16px; color: var(--color-gold); }
  .rte h3 { font-family: var(--font-heading); font-size: 1.3rem; margin-top: 32px; margin-bottom: 12px; }
  .rte p, .rte ul, .rte ol { margin-bottom: 20px; color: var(--color-text); }
  .rte ul, .rte ol { padding-left: 20px; }
  .rte li { margin-bottom: 8px; }
  .rte a { color: var(--color-gold); text-decoration: underline; }
  .rte hr { border: 0; border-top: 1px solid var(--color-border); margin: 40px 0; }
</style>

{% schema %}
{
  "name": "Page (editorial)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Information" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" }
  ]
}
{% endschema %}
