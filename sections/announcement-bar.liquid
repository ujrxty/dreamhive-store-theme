{%- if section.blocks.size > 0 -%}
<div class="announcement-bar" role="region" aria-label="Announcement">
  <div class="page-width">
    {%- assign first_block = section.blocks[0] -%}
    {%- if first_block.settings.link != blank -%}
      <a href="{{ first_block.settings.link }}">{{ first_block.settings.text }}</a>
    {%- else -%}
      <span>{{ first_block.settings.text }}</span>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free US shipping on orders over $199 · 30-day returns" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "message" }]
    }
  ]
}
{% endschema %}
