<header class="collection-header">
  <div class="page-width">
    {%- if collection.image and section.settings.show_image -%}
      <div style="max-width:960px;margin:0 auto 32px;aspect-ratio:16/6;overflow:hidden;border-radius:var(--radius);">
        <img src="{{ collection.image | image_url: width: 1800 }}" alt="{{ collection.title | escape }}" style="width:100%;height:100%;object-fit:cover;" loading="eager">
      </div>
    {%- endif -%}
    <h1>{{ collection.title | default: 'All products' }}</h1>
    {%- if collection.description != blank -%}
      <p>{{ collection.description }}</p>
    {%- endif -%}
  </div>
</header>

<div class="page-width">
  <div class="collection-toolbar">
    <div>{{ collection.products_count }} products</div>
    <form>
      <label for="SortBy" class="visually-hidden">{{ 'products.facets.sort_by' | t }}</label>
      <select id="SortBy" name="sort_by" onchange="this.form.submit()">
        {%- assign sort_options = 'manual,best-selling,title-ascending,title-descending,price-ascending,price-descending,created-descending' | split: ',' -%}
        {%- assign sort_labels = 'Featured,Best selling,Alphabetical A-Z,Alphabetical Z-A,Price: Low to high,Price: High to low,Newest' | split: ',' -%}
        {%- for opt in sort_options -%}
          <option value="{{ opt }}" {% if collection.sort_by == opt or collection.default_sort_by == opt %}selected{% endif %}>{{ sort_labels[forloop.index0] }}</option>
        {%- endfor -%}
      </select>
    </form>
  </div>

  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- if collection.products.size == 0 -%}
      <div style="text-align:center;padding:80px 0;color:var(--color-muted);">
        <p>No products in this collection yet.</p>
      </div>
    {%- else -%}
      <div class="grid grid--{{ section.settings.columns }}">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav style="display:flex;justify-content:center;gap:16px;margin:60px 0;" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn--outline">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn--outline">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "checkbox", "id": "show_image", "label": "Show collection image", "default": true },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 12, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
