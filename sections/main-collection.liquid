<header class="collection-header" data-reveal>
  <div class="page-width">
    {%- if section.settings.show_image and collection.image -%}
      <div style="max-width:1200px;margin:0 auto 40px;aspect-ratio:16/6;overflow:hidden;border-radius:var(--radius);">
        <img src="{{ collection.image | image_url: width: 2000 }}" alt="{{ collection.title | escape }}" style="width:100%;height:100%;object-fit:cover;" loading="eager" width="2000" height="750">
      </div>
    {%- endif -%}
    <div class="eyebrow--dot" style="justify-content:center;margin-bottom:16px;">{{ section.settings.eyebrow | default: 'Collection' }}</div>
    <h1 class="display-xl">{{ collection.title | default: 'All products' }}</h1>
    {%- if collection.description != blank -%}
      <p style="max-width:640px;margin:24px auto 0;color:var(--color-muted);">{{ collection.description }}</p>
    {%- endif -%}
  </div>
</header>

<div class="page-width collection-layout">
  {%- if section.settings.show_filters and collection.filters.size > 0 -%}
    <aside class="collection-filters" aria-label="Filters">
      <details open>
        <summary>Filter & sort</summary>
        <form>
          {%- for filter in collection.filters -%}
            <fieldset class="filter-group">
              <legend>{{ filter.label }}</legend>
              {%- case filter.type -%}
                {%- when 'list' -%}
                  {%- for value in filter.values -%}
                    <label class="filter-option {% if value.count == 0 and value.active == false %}is-disabled{% endif %}">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %} onchange="this.form.submit()">
                      <span>{{ value.label }} <em>({{ value.count }})</em></span>
                    </label>
                  {%- endfor -%}
                {%- when 'price_range' -%}
                  <div style="display:flex;gap:8px;">
                    <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" placeholder="Min" style="width:50%;padding:8px;background:transparent;border:1px solid var(--color-border);color:var(--color-text);border-radius:var(--radius-btn);">
                    <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" placeholder="Max" style="width:50%;padding:8px;background:transparent;border:1px solid var(--color-border);color:var(--color-text);border-radius:var(--radius-btn);">
                  </div>
                  <button type="submit" class="btn btn--outline" style="margin-top:12px;width:100%;padding:8px;min-height:auto;font-size:0.75rem;">Apply</button>
              {%- endcase -%}
            </fieldset>
          {%- endfor -%}
          {%- if collection.current_vendor or collection.current_type or collection.filters.size > 0 -%}
            <a href="{{ collection.url }}" class="btn btn--outline" style="margin-top:16px;width:100%;padding:10px;min-height:auto;font-size:0.75rem;">Clear all</a>
          {%- endif -%}
        </form>
      </details>
    </aside>
  {%- endif -%}

  <div class="collection-main">
    <div class="collection-toolbar">
      <div>{{ collection.products_count }} products</div>
      <form>
        <label for="SortBy" class="visually-hidden">{{ 'products.facets.sort_by' | t }}</label>
        <select id="SortBy" name="sort_by" onchange="this.form.submit()">
          {%- assign sort_options = 'manual,best-selling,title-ascending,title-descending,price-ascending,price-descending,created-descending' | split: ',' -%}
          {%- assign sort_labels = 'Featured,Best selling,A → Z,Z → A,Price ↑,Price ↓,Newest' | split: ',' -%}
          {%- for opt in sort_options -%}
            <option value="{{ opt }}" {% if collection.sort_by == opt or collection.default_sort_by == opt %}selected{% endif %}>{{ sort_labels[forloop.index0] }}</option>
          {%- endfor -%}
        </select>
      </form>
    </div>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size == 0 -%}
        <div style="text-align:center;padding:80px 0;color:var(--color-muted);">
          <p>No products match your selection.</p>
          <a href="{{ collection.url }}" class="btn btn--outline" style="margin-top:24px;">Reset filters</a>
        </div>
      {%- else -%}
        <div class="grid grid--{{ section.settings.columns }}">
          {%- for product in collection.products -%}
            <div data-reveal>{% render 'product-card', product: product %}</div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav style="display:flex;justify-content:center;gap:16px;margin:60px 0;" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn--outline">← Prev</a>{%- endif -%}
            <span style="align-self:center;color:var(--color-muted);font-size:0.85rem;">Page {{ paginate.current_page }} / {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn--outline">Next →</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

<style>
  .collection-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 48px;
    padding-bottom: 80px;
  }
  @media (max-width: 989px) {
    .collection-layout { grid-template-columns: 1fr; gap: 24px; }
  }
  .collection-filters details summary {
    list-style: none;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
  }
  .collection-filters details summary::after { content: '−'; }
  .collection-filters details:not([open]) summary::after { content: '+'; }
  .filter-group { border: 0; padding: 20px 0; margin: 0; border-bottom: 1px solid var(--color-border); }
  .filter-group legend { font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text); margin-bottom: 12px; padding: 0; }
  .filter-option { display: flex; align-items: center; gap: 10px; padding: 6px 0; font-size: 0.88rem; color: var(--color-muted); cursor: pointer; }
  .filter-option:hover { color: var(--color-text); }
  .filter-option em { font-style: normal; color: var(--color-muted); font-size: 0.78rem; }
  .filter-option.is-disabled { opacity: 0.4; cursor: not-allowed; }
  .filter-option input { accent-color: var(--color-gold); }
  @media (max-width: 989px) {
    .collection-filters details { border: 1px solid var(--color-border); border-radius: var(--radius); padding: 0 16px; }
  }
</style>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collection" },
    { "type": "checkbox", "id": "show_image", "label": "Show collection banner image", "default": true },
    { "type": "checkbox", "id": "show_filters", "label": "Show filter sidebar", "default": true, "info": "Filters must be configured in Shopify Admin → Search & Discovery." },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 12, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
