<section class="section">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <header class="section-header">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="grid grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        {%- assign image = block.settings.image | default: coll.image | default: coll.products.first.featured_image -%}
        <a href="{{ coll.url | default: block.settings.link }}" class="category-tile" {{ block.shopify_attributes }}>
          {%- if image -%}
            <img src="{{ image | image_url: width: 900 }}"
                 srcset="{{ image | image_url: width: 500 }} 500w, {{ image | image_url: width: 900 }} 900w"
                 sizes="(min-width: 990px) 33vw, 100vw"
                 alt="{{ block.settings.label | escape }}"
                 loading="lazy" width="900" height="1125">
          {%- else -%}
            <div style="width:100%;height:100%;background:var(--color-surface);"></div>
          {%- endif -%}
          <div class="category-tile__overlay">
            <span class="category-tile__label">{{ block.settings.label | default: coll.title }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by room" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for every corner of home" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2, "max": 4, "step": 1, "default": 3
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Living" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link (if no collection)" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides collection image)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "Living" } },
        { "type": "tile", "settings": { "label": "Bedroom" } },
        { "type": "tile", "settings": { "label": "Dining" } }
      ]
    }
  ]
}
{% endschema %}
