<section class="page-width" style="padding:80px 0;">
  <div class="contact-grid">
    <div>
      <div class="eyebrow--dot" style="margin-bottom:16px;">Get in touch</div>
      <h1 class="display-xl" style="margin-bottom:20px;">{{ page.title | default: 'Talk to us' }}</h1>
      {%- if page.content != blank -%}
        <div style="color:var(--color-muted);line-height:1.7;margin-bottom:32px;">{{ page.content }}</div>
      {%- else -%}
        <p style="color:var(--color-muted);line-height:1.7;margin-bottom:32px;">Questions about a piece? Need a design consult? Delivery timing? We reply within one business day.</p>
      {%- endif -%}

      <div style="display:grid;gap:20px;">
        {%- if section.settings.email != blank -%}
          <div>
            <div style="font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-gold);margin-bottom:6px;">Email</div>
            <a href="mailto:{{ section.settings.email }}" style="font-size:1.1rem;">{{ section.settings.email }}</a>
          </div>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <div>
            <div style="font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-gold);margin-bottom:6px;">Phone</div>
            <a href="tel:{{ section.settings.phone | replace: ' ', '' }}" style="font-size:1.1rem;">{{ section.settings.phone }}</a>
          </div>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <div>
            <div style="font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-gold);margin-bottom:6px;">Studio</div>
            <div style="font-size:1rem;color:var(--color-muted);white-space:pre-line;">{{ section.settings.address }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <div>
            <div style="font-size:0.72rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--color-gold);margin-bottom:6px;">Hours</div>
            <div style="font-size:1rem;color:var(--color-muted);white-space:pre-line;">{{ section.settings.hours }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div style="background:var(--color-surface);padding:40px;border-radius:var(--radius);">
      {%- form 'contact', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <div style="color:var(--color-gold);text-align:center;padding:20px;">Thank you we'll be in touch shortly.</div>
        {%- else -%}
          {{ form.errors | default_errors }}
          <h3 style="font-family:var(--font-heading);font-size:1.6rem;margin-bottom:24px;">Send us a note</h3>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <input type="text" name="contact[name]" placeholder="Name" required class="auth-input">
            <input type="email" name="contact[email]" placeholder="Email" required class="auth-input">
          </div>
          <input type="tel" name="contact[phone]" placeholder="Phone (optional)" class="auth-input">
          <textarea name="contact[body]" placeholder="How can we help?" rows="5" required class="auth-input" style="resize:vertical;"></textarea>
          <button type="submit" class="btn" style="width:100%;margin-top:12px;">Send message</button>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; max-width: 1200px; margin: 0 auto; }
  @media (max-width: 749px) { .contact-grid { grid-template-columns: 1fr; gap: 32px; } }
  .contact-form .auth-input { margin-bottom: 12px; }
</style>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "email", "label": "Email", "default": "hello@dreamhive.com" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(555) 123-4567" },
    { "type": "textarea", "id": "address", "label": "Studio address", "default": "123 Design Row\nBrooklyn, NY 11201" },
    { "type": "textarea", "id": "hours", "label": "Hours", "default": "Mon Fri  10a 6p\nSat  11a 5p\nSun closed" }
  ]
}
{% endschema %}
