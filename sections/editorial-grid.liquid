<section class="section">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <header style="margin-bottom:48px;max-width:640px;">
        {%- if section.settings.eyebrow != blank -%}<div class="eyebrow--dot" data-reveal>{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2 class="display-xl" data-split="words" style="margin-top:16px;">{{ section.settings.heading }}</h2>
      </header>
    {%- endif -%}

    <div class="editorial-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" style="display:block;overflow:hidden;border-radius:var(--radius);position:relative;" data-image-reveal {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.label | escape }}" loading="lazy" width="1200" height="1500" style="width:100%;height:100%;object-fit:cover;">
          {%- elsif block.settings.fallback_asset != blank -%}
            <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.label | escape }}" loading="lazy" width="1200" height="1500" style="width:100%;height:100%;object-fit:cover;">
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <div style="position:absolute;bottom:20px;left:20px;color:#fff;font-family:var(--font-heading);font-size:1.4rem;text-shadow:0 2px 8px rgba(0,0,0,0.5);">{{ block.settings.label }}</div>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial grid",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Live beautifully" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Fallback asset", "default": "cat-living.jpg" },
        { "type": "text", "id": "label", "label": "Label", "default": "Living" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial grid",
      "blocks": [
        { "type": "tile", "settings": { "label": "Living", "fallback_asset": "cat-living.jpg" } },
        { "type": "tile", "settings": { "label": "Bedroom", "fallback_asset": "cat-bedroom.jpg" } },
        { "type": "tile", "settings": { "label": "Craft", "fallback_asset": "editorial-craft.jpg" } },
        { "type": "tile", "settings": { "label": "Dining", "fallback_asset": "cat-dining.jpg" } }
      ]
    }
  ]
}
{% endschema %}
