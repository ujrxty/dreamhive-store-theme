<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{ shop.name }} Coming soon</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --color-bg: {{ settings.color_bg }};
      --color-text: {{ settings.color_text }};
      --color-gold: {{ settings.color_gold }};
      --font-heading: {{ settings.font_heading.family }}, serif;
      --font-body: {{ settings.font_body.family }}, sans-serif;
    }
    body { display: grid; place-items: center; min-height: 100vh; text-align: center; padding: 40px; }
    .password-shell { max-width: 480px; }
  </style>
</head>
<body>
  <div class="password-shell">
    {%- if settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="max-width:200px;margin:0 auto 32px;">
    {%- else -%}
      <h1 style="font-family:var(--font-heading);">{{ shop.name }}</h1>
    {%- endif -%}
    <p style="color:var(--color-muted);margin-bottom:32px;">Something beautiful is coming soon.</p>
    {%- form 'storefront_password' -%}
      <input type="password" name="password" placeholder="Enter store password" style="padding:12px 18px;background:transparent;border:1px solid var(--color-border);color:var(--color-text);border-radius:var(--radius-btn);margin-right:8px;">
      <button type="submit" class="btn">Enter</button>
    {%- endform -%}
  </div>
</body>
</html>
