        "m2": { "type": "item", "settings": { "text": "White-glove delivery" } },
        "m3": { "type": "item", "settings": { "text": "10-year warranty" } },
        "m4": { "type": "item", "settings": { "text": "Solid hardwood" } },
        "m5": { "type": "item", "settings": { "text": "Made to last" } }
      },
      "block_order": ["m1", "m2", "m3", "m4", "m5"]
    },
    "statement": {
      "type": "big-statement",
      "settings": {
        "eyebrow": "Our philosophy",
        "text": "<p>We believe furniture should <em>outlive trends</em>. Every DreamHive piece is designed to be loved for a lifetime — and passed on.</p>",
        "background": "default"
      }
    },
    "editorial-grid": {
      "type": "editorial-grid",
      "settings": {
        "eyebrow": "Shop by room",
        "heading": "Live beautifully."
      },
      "blocks": {
        "e1": { "type": "tile", "settings": { "label": "Living", "fallback_asset": "cat-living.jpg" } },
        "e2": { "type": "tile", "settings": { "label": "Bedroom", "fallback_asset": "cat-bedroom.jpg" } },
        "e3": { "type": "tile", "settings": { "label": "Craft", "fallback_asset": "editorial-craft.jpg" } },
        "e4": { "type": "tile", "settings": { "label": "Dining", "fallback_asset": "cat-dining.jpg" } }
      },
      "block_order": ["e1", "e2", "e3", "e4"]
    },
    "carousel": {
      "type": "product-carousel",
      "settings": {
        "eyebrow": "Just landed",
        "heading": "New this season",
        "product_limit": 8,
        "background": "surface"
      }
    },
    "numbered": {
      "type": "numbered-features",
      "settings": {
        "eyebrow": "The DreamHive standard",
        "heading": "Everything considered",
        "background": "default"
      },
      "blocks": {
        "n1": { "type": "feature", "settings": { "title": "Solid hardwood frames", "description": "Kiln-dried oak and walnut, joined by hand with mortise-and-tenon construction." } },
        "n2": { "type": "feature", "settings": { "title": "Full-grain leather", "description": "Sourced from Italian tanneries; ages with a patina that improves over decades." } },
        "n3": { "type": "feature", "settings": { "title": "White-glove delivery", "description": "Two-person team, room-of-choice placement, assembly, and packaging removal." } },
        "n4": { "type": "feature", "settings": { "title": "10-year warranty", "description": "On every frame and finish. We stand behind it because we made it to last." } }
      },
      "block_order": ["n1", "n2", "n3", "n4"]
    },
    "sticky-story": {
      "type": "sticky-story",
      "settings": {
        "eyebrow": "How it's made",
        "heading": "From workshop to your living room",
        "background": "surface"
      },
      "blocks": {
        "c1": { "type": "chapter", "settings": { "title": "Kiln-dried in Vermont", "body": "Every frame begins with Appalachian hardwood, kiln-dried for eight weeks to stabilize the grain before a saw ever touches it.", "fallback_asset": "editorial-craft.jpg" } },
        "c2": { "type": "chapter", "settings": { "title": "Joined by hand", "body": "Mortise-and-tenon joinery — the same technique that's held furniture together for 500 years. No staples, no shortcuts.", "fallback_asset": "cat-bedroom.jpg" } },
        "c3": { "type": "chapter", "settings": { "title": "Finished with care", "body": "Hand-rubbed oils and waxes bring out the wood's natural depth. No plastic sheens, no VOC lacquers.", "fallback_asset": "cat-dining.jpg" } }
      },
      "block_order": ["c1", "c2", "c3"]
    },
    "quote": {
      "type": "pull-quote",
      "settings": {
        "quote": "Timeless craftsmanship at prices that shouldn't exist.",
        "author": "Architectural Digest",
        "background": "default"
      }
