        "l2": { "type": "photo", "settings": { "fallback_asset": "look-2.jpg" } },
        "l3": { "type": "photo", "settings": { "fallback_asset": "look-3.jpg" } },
        "l4": { "type": "photo", "settings": { "fallback_asset": "look-4.jpg" } }
      },
      "block_order": ["l1", "l2", "l3", "l4"]
    },
    "newsletter": {
      "type": "newsletter",
      "settings": {
        "eyebrow": "Stay inspired",
        "heading": "Join the DreamHive list",
        "subheading": "10% off your first order plus early access to new drops.",
        "button_text": "Subscribe"
      }
