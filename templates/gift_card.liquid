<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Gift card — {{ shop.name }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body style="padding:60px 24px;text-align:center;">
  <div style="max-width:520px;margin:0 auto;">
    {%- if settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" style="max-width:180px;margin:0 auto 32px;">
    {%- endif -%}
    <h1 style="font-family:var(--font-heading);font-size:2.4rem;">You've received a gift card</h1>
    <div style="font-size:3rem;color:var(--color-gold);font-family:var(--font-heading);margin:24px 0;">{{ gift_card.initial_value | money }}</div>
    <div style="border:1px solid var(--color-border);padding:24px;border-radius:var(--radius);letter-spacing:0.2em;font-family:monospace;">
      {{ gift_card.code | format_code }}
    </div>
    <p style="color:var(--color-muted);margin-top:24px;">Redeem this code at checkout.</p>
    <a href="{{ shop.url }}" class="btn" style="margin-top:24px;">Shop {{ shop.name }}</a>
  </div>
</body>
</html>
