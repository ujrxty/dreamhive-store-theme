<section class="page-width section">
  <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:32px;">
    <h1>{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}" class="btn btn--outline">{{ 'customer.account.log_out' | t }}</a>
  </div>
  <h2>{{ 'customer.account.orders' | t }}</h2>
  {%- if customer.orders.size > 0 -%}
    <table style="width:100%;margin-top:20px;border-collapse:collapse;">
      <thead>
        <tr style="text-align:left;border-bottom:1px solid var(--color-border);">
          <th style="padding:12px 0;font-weight:500;">Order</th><th style="font-weight:500;">Date</th><th style="font-weight:500;">Total</th><th style="font-weight:500;">Status</th>
        </tr>
      </thead>
      <tbody>
        {%- for order in customer.orders -%}
          <tr style="border-bottom:1px solid var(--color-border);">
            <td style="padding:16px 0;"><a href="{{ order.customer_url }}" style="color:var(--color-gold);">{{ order.name }}</a></td>
            <td>{{ order.created_at | date: '%b %-d, %Y' }}</td>
            <td>{{ order.total_price | money }}</td>
            <td style="color:var(--color-muted);">{{ order.fulfillment_status_label }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  {%- else -%}
    <p style="color:var(--color-muted);">No orders yet.</p>
  {%- endif -%}
</section>
