<section class="page-width section" style="max-width:440px;">
  <h1 style="text-align:center;">Activate account</h1>
  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}
    <input type="password" name="customer[password]" placeholder="Password" required style="width:100%;padding:12px;background:transparent;border:1px solid var(--color-border);color:var(--color-text);margin-bottom:12px;border-radius:var(--radius-btn);">
    <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" required style="width:100%;padding:12px;background:transparent;border:1px solid var(--color-border);color:var(--color-text);margin-bottom:16px;border-radius:var(--radius-btn);">
    <button type="submit" class="btn" style="width:100%;">Activate</button>
    <button type="submit" name="decline" class="btn btn--outline" style="width:100%;margin-top:8px;">Decline</button>
  {%- endform -%}
</section>
