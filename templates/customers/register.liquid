<section class="page-width section" style="max-width:440px;">
  <h1 style="text-align:center;">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <input type="text" name="customer[first_name]" placeholder="{{ 'customer.register.first_name' | t }}" required style="width:100%;padding:12px;background:transparent;border:1px solid var(--color-border);color:var(--color-text);margin-bottom:12px;border-radius:var(--radius-btn);">
    <input type="text" name="customer[last_name]" placeholder="{{ 'customer.register.last_name' | t }}" required style="width:100%;padding:12px;background:transparent;border:1px solid var(--color-border);color:var(--color-text);margin-bottom:12px;border-radius:var(--radius-btn);">
    <input type="email" name="customer[email]" placeholder="{{ 'customer.register.email' | t }}" required style="width:100%;padding:12px;background:transparent;border:1px solid var(--color-border);color:var(--color-text);margin-bottom:12px;border-radius:var(--radius-btn);">
    <input type="password" name="customer[password]" placeholder="{{ 'customer.register.password' | t }}" required style="width:100%;padding:12px;background:transparent;border:1px solid var(--color-border);color:var(--color-text);margin-bottom:16px;border-radius:var(--radius-btn);">
    <button type="submit" class="btn" style="width:100%;">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</section>
